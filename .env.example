# Example environment file for fairscape-grok-grader
# Copy this file to .env and fill in your values.
# The package will automatically load XAI_API_KEY from .env when imported.

# Your xAI API key (get one at https://console.x.ai/)
XAI_API_KEY=your_xai_api_key_here

# Alternative key name also supported
# GROK_API_KEY=your_grok_api_key_here
